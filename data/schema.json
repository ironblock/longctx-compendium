{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Long Context Falloff Compendium data file",
  "type": "object",
  "required": ["meta", "platforms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "$ref": "#/definitions/meta" },
    "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/platform" } },
    "builds": { "type": "array", "items": { "$ref": "#/definitions/build" } }
  },

  "definitions": {
    "confidence": {
      "description": "m = measured primary · m~ = measured secondary/anecdotal · e = extrapolated · i = modeled from specs. Absence means no data; there is no code for it.",
      "enum": ["m", "m~", "e", "i"]
    },

    "measurement": {
      "description": "A benchmark number and how much to trust it. Tuple form for the common case, object form when it needs provenance.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [{ "type": "number" }, { "$ref": "#/definitions/confidence" }]
        },
        {
          "type": "object",
          "required": ["value", "confidence"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "number" },
            "confidence": { "$ref": "#/definitions/confidence" },
            "source": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      ]
    },

    "meta": {
      "type": "object",
      "required": ["contexts", "archetypes", "confidence", "electricityUsdPerKwh"],
      "additionalProperties": false,
      "properties": {
        "contexts": {
          "description": "The shared prefill x-axis. Adding a point here makes a column appear everywhere; platforms without that key render as gaps.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tokens", "label"],
            "additionalProperties": false,
            "properties": {
              "tokens": { "type": "integer", "minimum": 1 },
              "label": { "type": "string" }
            }
          }
        },
        "archetypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "desc"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "label": { "type": "string" },
              "desc": { "type": "string" }
            }
          }
        },
        "confidence": {
          "type": "object",
          "description": "Human-readable gloss for each confidence code, rendered in the legend.",
          "additionalProperties": { "type": "string" }
        },
        "electricityUsdPerKwh": { "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "display": {
      "type": "object",
      "required": ["label", "short", "color"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "short": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "group": { "type": "string" }
      }
    },

    "pricepoint": {
      "type": "object",
      "required": ["usd"],
      "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "asOf": {
          "description": "YYYY or YYYY-MM. A price without a date is not a fact.",
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2})?$"
        },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "pricing": {
      "description": "Open by design: add lease/used/bundle alongside msrp and street without a schema change.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/pricepoint" }
    },

    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": { "type": "string" },
        "released": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$" },
        "memoryGB": { "type": "number", "exclusiveMinimum": 0 },
        "memoryBandwidthGBs": { "type": "number", "exclusiveMinimum": 0 },
        "tdpW": { "type": "number", "exclusiveMinimum": 0 },
        "process": { "type": "string" },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": { "type": "string" },
            "note": { "type": "string" },
            "source": { "type": "string" },
            "values": {
              "description": "Rated throughput keyed by precision (fp32, tf32, bf16, fp16, fp8, fp4, int8, ...). Suffix a key with ':sparse' for structured-sparsity figures. New precisions need no schema change.",
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9]+(:sparse)?$" },
              "additionalProperties": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },

    "power": {
      "description": "Draw for ONE unit, observed under LLM inference. Deliberately not hardware.tdpW: inference is bandwidth-bound and does not reach the datasheet ceiling, and cards are commonly power-capped. Build totals are summed from this, never stored.",
      "type": "object",
      "required": ["loadW", "idleW"],
      "additionalProperties": false,
      "properties": {
        "loadW": { "type": "number", "exclusiveMinimum": 0 },
        "idleW": { "type": "number", "minimum": 0 },
        "confidence": { "$ref": "#/definitions/confidence" },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "unit": {
      "description": "A quantity of one purchasable thing. Reference a platform when one exists, otherwise carry the pricing and power inline.",
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "pricing": { "$ref": "#/definitions/pricing" },
        "power": { "$ref": "#/definitions/power" },
        "hardware": { "$ref": "#/definitions/hardware" }
      }
    },

    "archPerf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string" },
        "decodeNote": { "type": "string" },
        "unsupported": {
          "description": "True when this platform provably cannot run the archetype (capacity, not missing data). The note should say why.",
          "type": "boolean"
        },
        "prefill": {
          "description": "Prefill throughput keyed by exact prompt length in tokens. Keying by token count rather than array position means a value can never drift away from its confidence code, and an absent context is a gap rather than a silent shift.",
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "$ref": "#/definitions/measurement" }
        },
        "decode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "short": { "$ref": "#/definitions/measurement" },
            "at32k": { "$ref": "#/definitions/measurement" }
          }
        }
      }
    },

    "platform": {
      "type": "object",
      "required": ["id", "display"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display": { "$ref": "#/definitions/display" },
        "hardware": { "$ref": "#/definitions/hardware" },
        "pricing": { "$ref": "#/definitions/pricing" },
        "power": { "$ref": "#/definitions/power" },
        "perf": {
          "description": "Keyed by archetype id from meta.archetypes. Absent archetypes render as em dashes.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_]+$" },
          "additionalProperties": { "$ref": "#/definitions/archPerf" }
        },
        "extra": {
          "description": "Escape hatch for data captured before anyone decided how to render it. Nothing reads this.",
          "type": "object"
        }
      }
    },

    "build": {
      "description": "A purchasable box, expressed as the units it contains. Cost and power are summed from those units and never stored here.",
      "type": "object",
      "required": ["id", "display", "units"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "display": { "$ref": "#/definitions/display" },
        "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/unit" } },
        "host": {
          "description": "Whatever the units do not account for: chassis, CPU, PSU, cooling. Keeps the residual visible instead of hidden inside a card price.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "costUsd": { "type": "number", "minimum": 0 },
            "loadW": { "type": "number", "minimum": 0 },
            "idleW": { "type": "number", "minimum": 0 },
            "note": { "type": "string" }
          }
        },
        "decode": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_]+$" },
          "additionalProperties": { "$ref": "#/definitions/measurement" }
        },
        "extra": { "type": "object" }
      }
    }
  }
}
