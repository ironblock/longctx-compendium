{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Long Context Falloff Compendium data file",
  "type": "object",
  "required": [
    "meta",
    "units",
    "platforms"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/platform"
      }
    },
    "builds": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/build"
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/catalogUnit"
      }
    },
    "long_context_falloff": { "$ref": "#/definitions/appendixSection" },
    "kv_cache_quantization": { "$ref": "#/definitions/appendixSection" },
    "llama_cpp_sycl_tensor_parallel": { "$ref": "#/definitions/appendixSection" },
    "puget_arc_b70_fp16_measurements": { "$ref": "#/definitions/appendixSection" },
    "apple_silicon_decode_baseline": { "$ref": "#/definitions/appendixSection" },
    "apple_silicon_decode_estimates": { "$ref": "#/definitions/appendixSection" },
    "key_findings": {
      "description": "Prose synthesis of the appendix sections above. Not itself a source of numbers — every figure it restates must already be sourced in its section.",
      "type": "object"
    }
  },
  "definitions": {
    "appendixSection": {
      "description": "A secondary dataset merged in from an unmerged branch rather than modeled as units/platforms/builds — e.g. an anecdotal architecture comparison or a one-off lab benchmark. Loosely typed on purpose (shapes vary), but every section must say where it came from, and every individual number in it must carry a confidence code the same as any other measurement on this page.",
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "calibration_source": { "type": "string" },
        "neural_accelerator_source": { "type": "string" }
      }
    },
    "confidence": {
      "description": "m = measured primary · m~ = measured secondary/anecdotal · e = extrapolated · i = modeled from specs. Absence means no data; there is no code for it.",
      "enum": [
        "m",
        "m~",
        "e",
        "i"
      ]
    },
    "measurement": {
      "description": "A benchmark number and how much to trust it. Tuple form for the common case, object form when it needs provenance.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/confidence"
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "value",
            "confidence"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number"
            },
            "confidence": {
              "$ref": "#/definitions/confidence"
            },
            "source": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "contexts",
        "archetypes",
        "confidence",
        "electricityUsdPerKwh"
      ],
      "additionalProperties": false,
      "properties": {
        "contexts": {
          "description": "The shared prefill x-axis. Adding a point here makes a column appear everywhere; platforms without that key render as gaps.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tokens",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "tokens": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "archetypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "desc"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "label": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            }
          }
        },
        "confidence": {
          "type": "object",
          "description": "Human-readable gloss for each confidence code, rendered in the legend.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "electricityUsdPerKwh": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "display": {
      "type": "object",
      "required": [
        "label",
        "short",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "group": {
          "type": "string"
        }
      }
    },
    "pricepoint": {
      "type": "object",
      "required": [
        "usd"
      ],
      "additionalProperties": false,
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "asOf": {
          "description": "YYYY or YYYY-MM. A price without a date is not a fact.",
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2})?$"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pricing": {
      "description": "Open by design: add lease/used/bundle alongside msrp and street without a schema change.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/pricepoint"
      }
    },
    "power": {
      "description": "Draw for ONE unit, observed under LLM inference. Deliberately not hardware.tdpW: inference is bandwidth-bound and does not reach the datasheet ceiling, and cards are commonly power-capped. Build totals are summed from this, never stored.",
      "type": "object",
      "required": [
        "loadW",
        "idleW"
      ],
      "additionalProperties": false,
      "properties": {
        "loadW": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "idleW": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "unit": {
      "description": "A quantity of one platform or one catalog unit. Exactly one of `platform` or `unit` must be given.",
      "type": "object",
      "required": [
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "archPerf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string"
        },
        "decodeNote": {
          "type": "string"
        },
        "unsupported": {
          "description": "True when this platform provably cannot run the archetype (capacity, not missing data). The note should say why.",
          "type": "boolean"
        },
        "prefill": {
          "description": "Prefill throughput keyed by exact prompt length in tokens. Keying by token count rather than array position means a value can never drift away from its confidence code, and an absent context is a gap rather than a silent shift.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/measurement"
          }
        },
        "decode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "short": {
              "$ref": "#/definitions/measurement"
            },
            "at32k": {
              "$ref": "#/definitions/measurement"
            }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "required": [
        "id",
        "display",
        "composition"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "display": {
          "$ref": "#/definitions/display"
        },
        "composition": {
          "$ref": "#/definitions/composition"
        },
        "perf": {
          "description": "Keyed by archetype id from meta.archetypes. Absent archetypes render as em dashes.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/archPerf"
          }
        },
        "extra": {
          "description": "Escape hatch for data captured before anyone decided how to render it. Nothing reads this.",
          "type": "object"
        }
      }
    },
    "build": {
      "description": "A purchasable box, expressed as the units it contains. Cost and power are summed from those units and never stored here.",
      "type": "object",
      "required": [
        "id",
        "display",
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "display": {
          "$ref": "#/definitions/display"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/unit"
          }
        },
        "host": {
          "description": "Whatever the units do not account for: chassis, CPU, PSU, cooling. Keeps the residual visible instead of hidden inside a card price.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "costUsd": {
              "type": "number",
              "minimum": 0
            },
            "loadW": {
              "type": "number",
              "minimum": 0
            },
            "idleW": {
              "type": "number",
              "minimum": 0
            },
            "note": {
              "type": "string"
            }
          }
        },
        "decode": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/measurement"
          }
        },
        "extra": {
          "type": "object"
        }
      }
    },
    "catalogUnit": {
      "description": "A purchasable piece of hardware -- the thing a datasheet describes. Platforms and builds are quantities of these, so a price or spec corrected here corrects everything containing it.",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label": {
          "type": "string"
        },
        "vendor": {
          "type": "string",
          "description": "Sections the catalog table."
        },
        "released": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2})?$"
        },
        "memoryGB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memoryBandwidthGBs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tdpW": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Datasheet TDP. Recorded only; nothing derives from it -- see power."
        },
        "process": {
          "type": "string"
        },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "values": {
              "description": "Rated throughput keyed by precision (fp32, tf32, bf16, fp16, fp8, fp4, int8, ...). Suffix a key with ':sparse' for structured-sparsity figures. New precisions need no schema change.",
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9]+(:sparse)?$"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "unknown": {
              "description": "Precisions believed supported (or at least not ruled out) that no sourced figure was found for after a real search -- rendered as a colored '?' rather than a blank dash, so 'we don't have a number yet' reads differently from 'confirmed unsupported' or 'never looked'. Not a dumping ground for every unresearched precision -- only add a key here after an actual search came up empty.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(:sparse)?$"
              }
            },
            "unsupported": {
              "description": "Precisions confirmed architecturally absent on this part (not merely undocumented) -- still rendered as a dash, kept separate from 'unknown' so the two are never conflated. The reasoning belongs in the unit's note, not duplicated here.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(:sparse)?$"
              }
            }
          }
        },
        "pricing": {
          "$ref": "#/definitions/pricing"
        },
        "power": {
          "$ref": "#/definitions/power"
        },
        "extra": {
          "type": "object"
        },
        "sources": {
          "description": "Where this record's specifications came from. Required once any specification field is filled, so an unsourced number cannot land quietly.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string",
          "description": "Caveats — e.g. that a bandwidth figure is SoC-wide rather than a discrete card's."
        }
      }
    },
    "composition": {
      "description": "What this configuration is made of. Cost, power and capacity are summed from it; storing them directly is not allowed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "unit": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
